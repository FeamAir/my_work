# Скопируйте в .env и заполните. Файл .env НЕ коммитится (см. .gitignore).
# Пайплайн читает переменные из окружения; .env подхватывается автоматически.

# --- ОБЯЗАТЕЛЬНО: генерация картинок и видео (fal.ai) -------------------------
# https://fal.ai/dashboard/keys  (формат: "<key_id>:<key_secret>")
FAL_KEY=

# --- ОБЯЗАТЕЛЬНО: голоса, SFX, музыка (ElevenLabs) ----------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- ОБЯЗАТЕЛЬНО: хранилище Cloudflare R2 (S3 API) ----------------------------
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens (права Object Read & Write на бакет)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=anime-studio

# --- ОБЯЗАТЕЛЬНО для агентов (сценарий/режиссура): LLM ------------------------
ANTHROPIC_API_KEY=

# --- НЕОБЯЗАТЕЛЬНО: Gemini (резервная LLM / анализ изображений) ---------------
GEMINI_API_KEY=

# --- Бюджет и безопасность ----------------------------------------------------
# Жёсткий лимит суммарных (оценочных) расходов по output/costs.jsonl, USD.
# При превышении любой платный вызов выбрасывает BudgetExceeded. Пусто/0 = без лимита (не рекомендуется).
BUDGET_LIMIT_USD=20
# Платные вызовы запрещены, пока здесь не стоит 1 (разрешение директора студии).
STUDIO_ALLOW_PAID=0

# --- Необязательные настройки -------------------------------------------------
# Папка для результатов (по умолчанию ./output)
# OUTPUT_DIR=output
# Оценка цены кредита ElevenLabs в USD (зависит от плана; Creator ~0.00022-0.0003)
# ELEVENLABS_USD_PER_CREDIT=0.0003
